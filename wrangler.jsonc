{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instabox-panel",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "instabox-panel-db", "database_id": "1d183e97-7b78-4d74-84ce-602c700adb1d" }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Bind DB in the Cloudflare dashboard. Preserve that binding during future deploys.
  "unsafe": { "metadata": { "keep_bindings": ["d1", "secret_text", "secret_key"] } },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}
